# ============================================
# AI Context Brain - Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!
# ============================================

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=postgres;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true

# ============================================
# AI API KEYS
# ============================================
GEMINI_API_KEYS=your_free_gemini_api_key,your_paid_gemini_api_key

# ============================================
# JWT
# ============================================
JWT_SECRET=your_jwt_secret_min_32_chars

# ============================================
# PADDLE - Payment & Subscriptions
# https://vendors.paddle.com/authentication
# ============================================

# API Key (Paddle dashboard → Developer Tools → Authentication)
# Sandbox key starts with: test_
# Production key starts with: live_ (or no prefix)
Paddle__ApiKey=test_your_paddle_api_key

# Webhook Secret (Paddle dashboard → Developer Tools → Notifications → your webhook → Secret key)
Paddle__WebhookSecret=your_webhook_secret

# Price IDs (Paddle dashboard → Catalog → Prices → copy Price ID)
Paddle__ProMonthlyPriceId=pri_01abc123
Paddle__ProYearlyPriceId=pri_01abc456
Paddle__TeamMonthlyPriceId=pri_01abc789
Paddle__TeamYearlyPriceId=pri_01abcdef

# ============================================
# SMTP - Transactional Emails (Zoho Mail)
# ============================================
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USERNAME=support@aicontextbrain.me
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=support@aicontextbrain.me
SMTP_FROM_NAME=AI Context Brain
SMTP_ENABLE_SSL=true

# ============================================
# APP CONFIG
# ============================================
App__WebUrl=https://aicontextbrain.me

# ============================================
# RESEND - Web API Email Service (Recommended for Railway)
# ============================================
# If RESEND_API_KEY is configured, system will use Resend Web API (Port 443 HTTPS)
# If empty, it falls back to SMTP above.
RESEND_API_KEY=your_resend_api_key
# ============================================
# LOCAL DEV ONLY
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5001
