# ============================================
# AI Context Brain - VSCode Extension Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!
# ============================================

# Backend API Configuration
# Local development:
AI_PROJECT_BRAIN_API_URL=http://localhost:5001/api

# Production (Railway deployment):
# AI_PROJECT_BRAIN_API_URL=https://api.aicontextbrain.me

# Authentication (if using SaaS mode)
# AI_PROJECT_BRAIN_API_TOKEN=your-api-token-here

# Development mode (local file system mode vs API mode)
# Set to "true" to use local scanning (no backend required)
AI_PROJECT_BRAIN_LOCAL_MODE=false
